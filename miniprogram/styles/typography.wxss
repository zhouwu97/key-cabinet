.kc-title-xl {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.3;
  color: var(--kc-text-primary, #171a1d);
}

.kc-title-lg {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.35;
  color: var(--kc-text-primary, #171a1d);
}

.kc-title-md {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  color: var(--kc-text-primary, #171a1d);
}

.kc-body {
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--kc-text-primary, #171a1d);
}

.kc-caption {
  font-size: 24rpx;
  line-height: 1.4;
  color: var(--kc-text-secondary, #737a87);
}

.kc-muted {
  font-size: 24rpx;
  color: var(--kc-text-muted, #9aa0ac);
}
