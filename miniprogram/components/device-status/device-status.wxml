<view class="device-card">
  <view class="device-top">
    <view class="device-info">
      <view class="device-icon">🏢</view>
      <view>
        <view class="device-name">{{name || '智能钥匙柜'}}</view>
        <view wx:if="{{location}}" class="device-location">{{location}}</view>
      </view>
    </view>
    <status-badge text="{{statusLabel}}" tone="{{tone}}" dot="{{true}}" />
  </view>
  <view wx:if="{{totalCount !== undefined && totalCount > 0}}" class="device-meta">
    <text class="meta-item">在位可用：<text class="meta-highlight">{{availableCount}}</text> / {{totalCount}} 把</text>
  </view>
</view>
