.borrow-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.borrow-card-overdue {
  border-left: 8rpx solid #ee0a24;
  background-color: #fffbfa;
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1px solid #f0f1f3;
}

.key-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}

.card-body {
  padding: 16rpx 0 8rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.info-line {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
}

.info-label {
  color: #8a919f;
}

.info-val {
  color: #1f2329;
  font-weight: 500;
  text-align: right;
  max-width: 440rpx;
}

.overdue-text {
  color: #ee0a24;
  font-size: 24rpx;
  margin-left: 8rpx;
}

.tone-red {
  color: #ee0a24;
}

.card-actions {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1px solid #f0f1f3;
}

.btn-return {
  background-color: #2f6bff;
  color: #ffffff;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.borrow-card-overdue .btn-return {
  background-color: #ee0a24;
}
