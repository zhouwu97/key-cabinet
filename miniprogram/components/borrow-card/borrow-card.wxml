<view class="card borrow-card {{borrow.isOverdue ? 'task-accent' : ''}}">
  <view class="card-head">
    <view class="task-title">{{borrow.keyName}}</view>
    <status-badge
      text="{{borrow.statusLabel || (borrow.isOverdue ? '已逾期' : '借用中')}}"
      tone="{{borrow.statusTone || (borrow.isOverdue ? 'red' : 'green')}}"
      dot="{{false}}"
    />
  </view>

  <view class="task-table">
    <view wx:if="{{borrow.borrowedAtText}}" class="kv">
      <text class="kv-label">借出时间</text>
      <text class="kv-val">{{borrow.borrowedAtText}}</text>
    </view>
    <view wx:if="{{borrow.expectedReturnText}}" class="kv">
      <text class="kv-label">应还时间</text>
      <text class="kv-val {{borrow.isOverdue ? 'danger' : ''}}">{{borrow.expectedReturnText}}</text>
    </view>
    <view wx:if="{{borrow.returnedAtText}}" class="kv">
      <text class="kv-label">归还时间</text>
      <text class="kv-val">{{borrow.returnedAtText}}</text>
    </view>
    <view wx:if="{{borrow.purpose}}" class="kv">
      <text class="kv-label">借用用途</text>
      <text class="kv-val">{{borrow.purpose}}</text>
    </view>
    <view wx:if="{{borrow.notes}}" class="kv">
      <text class="kv-label">异常备注</text>
      <text class="kv-val danger">{{borrow.notes}}</text>
    </view>
  </view>

  <view wx:if="{{borrow.canReturn !== false && showReturnBtn}}" class="card-actions">
    <view
      class="{{borrow.isOverdue ? 'danger-btn' : 'primary-btn'}}"
      catchtap="onReturn"
    >
      {{borrow.isOverdue ? '前往归还' : '发起归还'}}
    </view>
  </view>
</view>
