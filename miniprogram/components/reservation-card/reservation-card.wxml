<view class="card reservation-card">
  <view class="card-head">
    <view class="task-title">{{reservation.roomNo ? reservation.roomNo + ' ' : ''}}{{reservation.keyName}}</view>
    <status-badge text="{{reservation.statusLabel || '待取钥'}}" tone="{{reservation.statusTone || 'blue'}}" dot="{{false}}" />
  </view>

  <view class="task-table">
    <view class="kv">
      <text class="kv-label">取钥窗口</text>
      <text class="kv-val">{{reservation.pickupWindowText || (reservation.pickupWindowStartText + ' - ' + reservation.pickupWindowEndText)}}</text>
    </view>
    <view wx:if="{{reservation.expectedReturnText}}" class="kv">
      <text class="kv-label">预计归还</text>
      <text class="kv-val">{{reservation.expectedReturnText}}</text>
    </view>
    <view wx:if="{{reservation.purpose}}" class="kv">
      <text class="kv-label">借用用途</text>
      <text class="kv-val">{{reservation.purpose}}</text>
    </view>
  </view>

  <view wx:if="{{reservation.canPickup || reservation.canCancel || showActions}}" class="card-actions">
    <view
      wx:if="{{reservation.canPickup !== false}}"
      class="primary-btn action-btn"
      catchtap="onPickup"
    >
      现场取钥
    </view>
    <view
      wx:if="{{reservation.canCancel}}"
      class="outline-btn action-btn"
      catchtap="onCancel"
    >
      取消预约
    </view>
  </view>
</view>
