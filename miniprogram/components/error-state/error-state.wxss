.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  text-align: center;
}

.error-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #feebe7;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.error-icon-img {
  width: 56rpx;
  height: 56rpx;
  display: block;
}

.error-title {
  font-size: 30rpx;
  font-weight: 650;
  color: var(--kc-danger, #e5484d);
  margin-bottom: 12rpx;
}

.error-msg {
  font-size: 26rpx;
  color: var(--kc-text-muted, #9299a6);
  line-height: 1.5;
  max-width: 480rpx;
  margin-bottom: 32rpx;
}

.error-btn {
  background-color: var(--kc-surface-2, #f8f9fb);
  color: var(--kc-text-primary, #20242c);
  border: 1rpx solid var(--kc-line-strong, #d9dde5);
  padding: 16rpx 44rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 550;
}

.error-btn:active {
  background-color: #edeef2;
}
