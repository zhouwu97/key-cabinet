.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 88rpx;
  line-height: 1;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1f2329;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #8a919f;
  line-height: 1.5;
  max-width: 480rpx;
  margin-bottom: 32rpx;
}

.empty-btn {
  background-color: #2f6bff;
  color: #ffffff;
  padding: 18rpx 48rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(47, 107, 255, 0.2);
}
