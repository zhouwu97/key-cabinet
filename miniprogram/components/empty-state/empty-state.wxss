.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  text-align: center;
}

.empty-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: var(--kc-surface-2, #f8f9fb);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.empty-icon-img {
  width: 56rpx;
  height: 56rpx;
  display: block;
}

.empty-icon-text {
  font-size: 54rpx;
  line-height: 1;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 650;
  color: var(--kc-text-primary, #20242c);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--kc-text-muted, #9299a6);
  line-height: 1.5;
  max-width: 480rpx;
  margin-bottom: 32rpx;
}

.empty-btn {
  background-color: var(--kc-primary, #2f67f6);
  color: #ffffff;
  padding: 18rpx 48rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(47, 103, 246, 0.24);
}
