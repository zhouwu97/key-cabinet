.key-card {
  padding: 28rpx 28rpx 24rpx;
  margin-bottom: 20rpx;
  transition: transform 0.15s ease;
}

.key-card:active {
  transform: translateY(2rpx);
}

.key-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
}

.key-top-left {
  flex: 1;
}

.key-room {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--kc-text-primary, #20242c);
  line-height: 1.25;
}

.key-loc {
  margin-top: 8rpx;
  color: var(--kc-text-muted, #9299a6);
  font-size: 24rpx;
}

.key-use {
  margin-top: 20rpx;
  color: var(--kc-text-secondary, #5e6673);
  font-size: 26rpx;
  line-height: 1.5;
}

.key-bottom {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--kc-line, #e7e9ee);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.key-rule-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.key-rule {
  font-size: 22rpx;
  font-weight: 550;
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
}

.rule-available {
  color: var(--kc-success, #0ca678);
  background-color: var(--kc-success-soft, #eaf8f3);
}

.rule-borrowed,
.rule-approval {
  color: var(--kc-warning, #d67a16);
  background-color: var(--kc-warning-soft, #fff5e9);
}

.rule-disabled {
  color: var(--kc-danger, #e5484d);
  background-color: var(--kc-danger-soft, #fff0f0);
}

.detail-link {
  color: var(--kc-primary, #2f67f6);
  font-size: 24rpx;
  font-weight: 600;
}
