page {
  background-color: #f5f6f8;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.page {
  padding: 24rpx;
  min-height: 100vh;
}

.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
  margin-bottom: 24rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1px solid #f0f1f3;
}

.info-row:last-child {
  border-bottom: none;
}

.row-between {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
}

.list-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1px solid #f0f1f3;
  gap: 24rpx;
}

.list-item:last-child {
  border-bottom: none;
}

.key-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #1f2329;
  margin-bottom: 8rpx;
}

.muted {
  font-size: 26rpx;
  color: #8a919f;
  line-height: 1.6;
}

.muted.small {
  font-size: 24rpx;
  margin-top: 4rpx;
}

/* 状态颜色 */
.tone-green {
  color: #00b578;
}

.tone-blue {
  color: #2f6bff;
}

.tone-orange {
  color: #ff8f1f;
}

.tone-red {
  color: #ee0a24;
}

.tone-gray {
  color: #8a919f;
}

/* 按钮 */
.btn-primary {
  background-color: #2f6bff;
  color: #ffffff;
  padding: 24rpx 48rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  margin: 24rpx 0;
}

.btn-disabled {
  background-color: #e8e9eb;
  color: #8a919f;
  padding: 24rpx 48rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  margin: 24rpx 0;
}

.btn-ghost {
  background-color: transparent;
  color: #2f6bff;
  border: 1px solid #2f6bff;
  padding: 16rpx 32rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  text-align: center;
}

.btn-small {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
}

.center {
  margin-left: auto;
  margin-right: auto;
}

/* 搜索框 */
.search-box {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.search-box input {
  font-size: 30rpx;
}

/* 筛选标签 */
.chips {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}

.chip {
  background-color: #ffffff;
  color: #646a73;
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.chip-active {
  background-color: #2f6bff;
  color: #ffffff;
  font-weight: 500;
}

/* 网格 */
.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.grid-item {
  background-color: #f7f8fa;
  padding: 32rpx;
  border-radius: 16rpx;
  text-align: center;
  font-size: 30rpx;
  color: #1f2329;
}

/* 状态 */
.loading-state,
.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 120rpx 0;
  color: #8a919f;
  font-size: 28rpx;
}

/* 占位提示 */
.placeholder-note {
  text-align: center;
  color: #c9cdd4;
  font-size: 24rpx;
  margin-top: 48rpx;
  padding: 24rpx;
}
