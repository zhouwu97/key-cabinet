@import "./styles/tokens.wxss";
@import "./styles/typography.wxss";
@import "./styles/layout.wxss";
@import "./styles/utilities.wxss";

page {
  background-color: var(--kc-bg, #f5f6f8);
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", "Microsoft YaHei", sans-serif;
  color: var(--kc-text-primary, #20242c);
  -webkit-font-smoothing: antialiased;
}

.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background-color: var(--kc-bg, #f5f6f8);
}

/* 高保真原型卡片基类 */
.card {
  background-color: var(--kc-surface, #ffffff);
  border: 1rpx solid var(--kc-border, rgba(227, 230, 236, 0.9));
  border-radius: var(--kc-radius-lg, 32rpx);
  padding: 28rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--kc-shadow-card, 0 2rpx 4rpx rgba(20, 28, 44, 0.02));
  box-sizing: border-box;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--kc-text-primary, #20242c);
  margin-bottom: 24rpx;
}

/* 键值对表格 (KV Table) */
.task-table {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.kv {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  font-size: 26rpx;
  line-height: 1.5;
  gap: 24rpx;
}

.kv-label {
  color: var(--kc-text-muted, #9299a6);
  flex-shrink: 0;
  width: 168rpx;
}

.kv-val {
  color: var(--kc-text-primary, #20242c);
  font-weight: 550;
  text-align: right;
  flex: 1;
  word-break: break-all;
}

.kv-val.danger {
  color: var(--kc-danger, #e5484d);
}

/* 状态芯片 (Status Chips) */
.status-chip {
  display: inline-flex;
  align-items: center;
  font-size: 22rpx;
  font-weight: 650;
  border-radius: var(--kc-radius-sm, 16rpx);
  padding: 6rpx 16rpx;
  line-height: 1.3;
}

.chip-blue {
  color: var(--kc-primary, #2f67f6);
  background-color: var(--kc-primary-soft, #eef3ff);
}

.chip-green {
  color: var(--kc-success, #0ca678);
  background-color: var(--kc-success-soft, #eaf8f3);
}

.chip-orange {
  color: var(--kc-warning, #d67a16);
  background-color: var(--kc-warning-soft, #fff5e9);
}

.chip-red {
  color: var(--kc-danger, #e5484d);
  background-color: var(--kc-danger-soft, #fff0f0);
}

.chip-gray {
  color: var(--kc-text-secondary, #5e6673);
  background-color: var(--kc-surface-2, #f8f9fb);
}

/* 原型标准操作按钮 */
.primary-btn {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  border: 0;
  border-radius: var(--kc-radius-md, 20rpx);
  background-color: var(--kc-primary, #2f67f6);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 650;
  text-align: center;
  box-sizing: border-box;
}

.primary-btn:active {
  background-color: var(--kc-primary-hover, #2458dc);
}

.danger-btn {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  border: 0;
  border-radius: var(--kc-radius-md, 20rpx);
  background-color: var(--kc-danger, #e5484d);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 650;
  text-align: center;
  box-sizing: border-box;
}

.outline-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  border: 1rpx solid var(--kc-line-strong, #d9dde5);
  background-color: #ffffff;
  color: var(--kc-text-secondary, #5e6673);
  border-radius: var(--kc-radius-md, 20rpx);
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  box-sizing: border-box;
}

.link-btn {
  color: var(--kc-primary, #2f67f6);
  font-size: 24rpx;
  font-weight: 600;
  padding: 8rpx 0;
}

/* 警示卡片强调条 */
.task-accent {
  border-left: 6rpx solid var(--kc-danger, #e5484d) !important;
}

/* 兼容保留历史类 */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--kc-line, #e7e9ee);
}

.info-row:last-child {
  border-bottom: none;
}

.row-between {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
}

.list-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--kc-line, #e7e9ee);
  gap: 24rpx;
}

.list-item:last-child {
  border-bottom: none;
}

.key-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--kc-text-primary, #20242c);
  margin-bottom: 8rpx;
}

.muted {
  font-size: 26rpx;
  color: var(--kc-text-muted, #9299a6);
  line-height: 1.6;
}

.muted.small {
  font-size: 24rpx;
  margin-top: 4rpx;
}

/* 状态颜色 */
.tone-green { color: var(--kc-success, #0ca678); }
.tone-blue { color: var(--kc-primary, #2f67f6); }
.tone-orange { color: var(--kc-warning, #d67a16); }
.tone-red { color: var(--kc-danger, #e5484d); }
.tone-gray { color: var(--kc-text-muted, #9299a6); }

/* 传统按钮兼容 */
.btn-primary {
  background-color: var(--kc-primary, #2f67f6);
  color: #ffffff;
  padding: 24rpx 48rpx;
  border-radius: var(--kc-radius-md, 20rpx);
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  margin: 24rpx 0;
}

.btn-disabled {
  background-color: #e8e9eb;
  color: var(--kc-text-muted, #9299a6);
  padding: 24rpx 48rpx;
  border-radius: var(--kc-radius-md, 20rpx);
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  margin: 24rpx 0;
}

.btn-ghost {
  background-color: transparent;
  color: var(--kc-primary, #2f67f6);
  border: 1rpx solid var(--kc-primary, #2f67f6);
  padding: 16rpx 32rpx;
  border-radius: var(--kc-radius-sm, 16rpx);
  font-size: 28rpx;
  text-align: center;
}

.btn-small {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
}

.center {
  margin-left: auto;
  margin-right: auto;
}

/* 状态展示容器 */
.loading-state,
.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
  color: var(--kc-text-muted, #9299a6);
  font-size: 28rpx;
}

.placeholder-note {
  text-align: center;
  color: var(--kc-text-muted, #9299a6);
  font-size: 24rpx;
  margin-top: 48rpx;
  padding: 24rpx;
}
