.bind-header {
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #315ef6 0%, #1f47d4 100%);
  color: #ffffff;
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
}

.bind-title {
  font-size: 38rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
  letter-spacing: 0.5rpx;
}

.bind-desc {
  font-size: 26rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.88);
}

.form-card {
  padding: 32rpx;
  border-radius: 20rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 8rpx;
}

.form-label {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.label-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #171a1d;
}

.required {
  color: #e5484d;
  margin-left: 8rpx;
  font-size: 28rpx;
}

.optional {
  color: #737a87;
  font-size: 24rpx;
  margin-left: 8rpx;
}

.form-input {
  width: 100%;
  height: 84rpx;
  background-color: #f7f8fa;
  border: 2rpx solid #eceef2;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #171a1d;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #315ef6;
  background-color: #ffffff;
}

.placeholder {
  color: #a0a6b2;
}

.quick-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.tag {
  padding: 8rpx 20rpx;
  background-color: #f0f2f5;
  color: #4b525d;
  font-size: 24rpx;
  border-radius: 24rpx;
  transition: all 0.2s ease;
}

.tag-active {
  background-color: #eaf0ff;
  color: #315ef6;
  font-weight: 500;
}

.notice-card {
  border-left: 6rpx solid #e98b16;
  padding: 24rpx 28rpx;
}

.notice-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #8c5208;
  margin-bottom: 12rpx;
}

.notice-item {
  font-size: 24rpx;
  color: #737a87;
  line-height: 1.6;
}

.submit-btn-wrap {
  margin: 40rpx 0 60rpx 0;
}

.submit-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  background-color: #315ef6;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 46rpx;
  box-shadow: 0 6rpx 16rpx rgba(49, 94, 246, 0.3);
}

.submit-btn.disabled {
  opacity: 0.6;
}
