.identity-page {
  padding: 24rpx;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  background-color: var(--kc-bg, #f5f6f8);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 顶部说明卡片 (.identity-intro) */
.identity-intro {
  padding: 32rpx;
  margin-bottom: 24rpx;
  border-left: 6rpx solid var(--kc-primary, #2f67f6);
}

.intro-title {
  font-size: 36rpx;
  font-weight: 750;
  color: var(--kc-text-primary, #20242c);
  margin-bottom: 12rpx;
}

.intro-desc {
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--kc-text-secondary, #5e6673);
}

/* 表单卡片 (.form-card) */
.form-card {
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.field {
  margin-bottom: 30rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.field-label {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  font-weight: 650;
  color: var(--kc-text-primary, #20242c);
  margin-bottom: 14rpx;
}

.req {
  color: var(--kc-danger, #e5484d);
  margin-left: 6rpx;
  font-weight: 700;
}

.field-hint {
  font-size: 22rpx;
  color: var(--kc-text-muted, #9299a6);
  margin-left: 10rpx;
  font-weight: 400;
}

.field-input {
  width: 100%;
  height: 88rpx;
  border: 1rpx solid var(--kc-line, #e7e9ee);
  border-radius: var(--kc-radius-md, 20rpx);
  background-color: #fafbfc;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: var(--kc-text-primary, #20242c);
  box-sizing: border-box;
}

.field-input:focus {
  border-color: #b7c8ff;
  background-color: #ffffff;
}

.field-placeholder {
  color: #a1a8b3;
  font-size: 26rpx;
}

/* 学院选择标签 (.chips & .choice) */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
}

.choice {
  border: 1rpx solid var(--kc-line, #e7e9ee);
  background-color: #ffffff;
  color: var(--kc-text-secondary, #5e6673);
  border-radius: 16rpx;
  padding: 12rpx 18rpx;
  font-size: 22rpx;
  font-weight: 500;
  transition: all 0.15s ease;
}

.choice:active,
.choice-active {
  background-color: var(--kc-primary-soft, #eef3ff);
  color: var(--kc-primary, #2f67f6);
  border-color: #d9e3ff;
  font-weight: 600;
}

/* 认证须知暖色警示卡 (.notice) */
.notice {
  margin-top: 24rpx;
  padding: 26rpx 28rpx;
  border-radius: var(--kc-radius-md, 24rpx);
  background-color: #fffaf2;
  border: 1rpx solid #f3e2c3;
  color: #725327;
  font-size: 22rpx;
  line-height: 1.7;
  box-sizing: border-box;
}

.notice-title {
  display: block;
  color: #965c13;
  font-size: 24rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.notice-text {
  font-size: 22rpx;
  color: #725327;
}

/* 底部悬浮提交按钮条 (.identity-submit-wrap) */
.identity-submit-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  background-color: rgba(255, 255, 255, 0.97);
  border-top: 1rpx solid var(--kc-line, #e7e9ee);
  z-index: 26;
  box-sizing: border-box;
}

.submit-btn {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: var(--kc-radius-md, 20rpx);
  font-size: 28rpx;
  font-weight: 650;
}

.submit-btn.disabled {
  opacity: 0.6;
}
