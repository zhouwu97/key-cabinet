<view class="page identity-page">
  <!-- 顶部说明卡片 -->
  <view class="identity-intro card">
    <view class="intro-title">完善身份信息</view>
    <view class="intro-desc">
      绑定校内真实身份后，可进行钥匙预约、扫码取钥与归还。提交后由系统核验，资料仅用于借还记录和安全追溯。
    </view>
  </view>

  <!-- 表单主体卡片 -->
  <view class="form-card card">
    <view class="field">
      <view class="field-label">
        <text>真实姓名</text>
        <text class="req">*</text>
      </view>
      <input
        class="field-input"
        placeholder="请输入您的真实姓名"
        placeholder-class="field-placeholder"
        value="{{name}}"
        bindinput="onInputName"
        maxlength="20"
      />
    </view>

    <view class="field">
      <view class="field-label">
        <text>学号 / 工号</text>
        <text class="req">*</text>
      </view>
      <input
        class="field-input"
        placeholder="例如：2021001"
        placeholder-class="field-placeholder"
        value="{{studentNo}}"
        bindinput="onInputStudentNo"
        maxlength="30"
      />
    </view>

    <view class="field">
      <view class="field-label">
        <text>所属学院 / 部门</text>
        <text class="req">*</text>
      </view>
      <input
        class="field-input"
        placeholder="例如：计算机科学与技术学院"
        placeholder-class="field-placeholder"
        value="{{department}}"
        bindinput="onInputDepartment"
        maxlength="50"
      />
      <view class="chips">
        <view
          wx:for="{{departmentSuggestions}}"
          wx:key="*this"
          class="choice {{department === item ? 'choice-active' : ''}}"
          bindtap="onSelectDepartment"
          data-dep="{{item}}"
        >
          {{item}}
        </view>
      </view>
    </view>

    <view class="field">
      <view class="field-label">
        <text>联系手机</text>
        <text class="field-hint">用于逾期或异常通知</text>
      </view>
      <input
        class="field-input"
        type="number"
        placeholder="请输入11位手机号码"
        placeholder-class="field-placeholder"
        value="{{phone}}"
        bindinput="onInputPhone"
        maxlength="11"
      />
    </view>
  </view>

  <!-- 认证须知暖色警示卡 -->
  <view class="notice">
    <view class="notice-title">认证说明</view>
    <view class="notice-text">学号或工号将作为权限核验与借还台账依据；提交后身份信息不可随意修改，如需更正请联系管理员。</view>
  </view>

  <!-- 底部固定悬浮提交栏 -->
  <view class="identity-submit-wrap">
    <button
      class="primary-btn submit-btn {{submitting ? 'disabled' : ''}}"
      loading="{{submitting}}"
      bindtap="onSubmit"
    >
      提交身份信息
    </button>
  </view>
</view>
