.page {
  padding: 24rpx;
  background-color: var(--kc-bg, #f5f6f8);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 原型分段式 Tab 切换器 (.record-switch) */
.record-switch {
  background-color: #ffffff;
  padding: 8rpx;
  border: 1rpx solid var(--kc-line, #e7e9ee);
  border-radius: var(--kc-radius-md, 24rpx);
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  margin-bottom: 32rpx;
  box-shadow: var(--kc-shadow-card, 0 2rpx 4rpx rgba(20, 28, 44, 0.02));
}

.record-tab {
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 18rpx;
  color: var(--kc-text-secondary, #5e6673);
  font-size: 26rpx;
  font-weight: 600;
  transition: all 0.15s ease;
}

.record-tab.active {
  color: var(--kc-primary, #2f67f6);
  background-color: var(--kc-primary-soft, #eef3ff);
}

.record-group {
  margin-bottom: 32rpx;
}

.resume-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
  color: var(--kc-primary, #2f67f6);
  font-size: 28rpx;
}

.center-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e1e3e6;
  border-top-color: var(--kc-primary, #2f67f6);
  border-radius: 50%;
  animation: spin 0.8s infinite linear;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 26rpx;
  color: var(--kc-text-muted, #9299a6);
}
