<view class="page">
  <!-- 顶部 Tab 导航 -->
  <view class="tab-bar">
    <view
      class="tab-item {{activeTab === 'CURRENT' ? 'tab-item-active' : ''}}"
      bindtap="onTabChange"
      data-tab="CURRENT"
    >
      借用中 ({{currentBorrows.length}})
    </view>
    <view
      class="tab-item {{activeTab === 'RESERVATIONS' ? 'tab-item-active' : ''}}"
      bindtap="onTabChange"
      data-tab="RESERVATIONS"
    >
      我的预约 ({{reservations.length}})
    </view>
    <view
      class="tab-item {{activeTab === 'HISTORY' ? 'tab-item-active' : ''}}"
      bindtap="onTabChange"
      data-tab="HISTORY"
    >
      已归还 ({{historyBorrows.length}})
    </view>
    <view
      class="tab-item {{activeTab === 'EXCEPTION' ? 'tab-item-active' : ''}}"
      bindtap="onTabChange"
      data-tab="EXCEPTION"
    >
      逾期/异常 ({{exceptionBorrows.length}})
    </view>
  </view>

  <!-- 1. 加载中状态 (Loading) -->
  <view wx:if="{{loading}}" class="card center-loading">
    <view class="loading-spinner"></view>
    <view class="loading-text">正在加载台账记录...</view>
  </view>

  <!-- 2. 当前借用 TAB (CURRENT) -->
  <view wx:elif="{{activeTab === 'CURRENT'}}">
    <view wx:if="{{currentBorrows.length === 0}}" class="card">
      <empty-state
        icon="🔑"
        title="当前无进行中的借用"
        description="您当前没有借出中的钥匙，如需使用请前往找钥匙预约"
        actionText="去预约钥匙"
        bindaction="goKeys"
      />
    </view>
    <view wx:else>
      <view wx:for="{{currentBorrows}}" wx:key="id">
        <borrow-card
          borrow="{{item}}"
          showReturnBtn="{{true}}"
          bindreturn="onBorrowReturn"
        />
      </view>
    </view>
  </view>

  <!-- 3. 我的预约 TAB (RESERVATIONS) -->
  <view wx:elif="{{activeTab === 'RESERVATIONS'}}">
    <view wx:if="{{reservations.length === 0}}" class="card">
      <empty-state
        icon="📅"
        title="暂无有效预约"
        description="您可以提前预约所需实验室或会议室钥匙"
        actionText="找钥匙预约"
        bindaction="goKeys"
      />
    </view>
    <view wx:else>
      <view wx:for="{{reservations}}" wx:key="id">
        <reservation-card
          reservation="{{item}}"
          showActions="{{true}}"
          bindpickup="onReservationPickup"
          bindcancel="onReservationCancel"
        />
      </view>
    </view>
  </view>

  <!-- 4. 历史归还 TAB (HISTORY) -->
  <view wx:elif="{{activeTab === 'HISTORY'}}">
    <view wx:if="{{historyBorrows.length === 0}}" class="card">
      <empty-state
        icon="📋"
        title="暂无已归还记录"
        description="完成借还结算后的台账记录将在此展示"
      />
    </view>
    <view wx:else>
      <view wx:for="{{historyBorrows}}" wx:key="id">
        <borrow-card
          borrow="{{item}}"
          showReturnBtn="{{false}}"
        />
      </view>
    </view>
  </view>

  <!-- 5. 异常/逾期 TAB (EXCEPTION) -->
  <view wx:elif="{{activeTab === 'EXCEPTION'}}">
    <view wx:if="{{exceptionBorrows.length === 0}}" class="card">
      <empty-state
        icon="🎉"
        title="信用良好！"
        description="暂无逾期或异常未结记录，请继续保持准时借还守则"
      />
    </view>
    <view wx:else>
      <view wx:for="{{exceptionBorrows}}" wx:key="id">
        <borrow-card
          borrow="{{item}}"
          showReturnBtn="{{true}}"
          bindreturn="onBorrowReturn"
        />
      </view>
    </view>
  </view>
</view>
