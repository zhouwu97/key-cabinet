<view class="page">
  <view class="chips">
    <view
      class="chip {{activeTab === 'RESERVATIONS' ? 'chip-active' : ''}}"
      bindtap="onTabChange"
      data-tab="RESERVATIONS"
    >
      预约
    </view>
    <view
      class="chip {{activeTab === 'CURRENT' ? 'chip-active' : ''}}"
      bindtap="onTabChange"
      data-tab="CURRENT"
    >
      借用中
    </view>
    <view
      class="chip {{activeTab === 'HISTORY' ? 'chip-active' : ''}}"
      bindtap="onTabChange"
      data-tab="HISTORY"
    >
      已完成
    </view>
    <view
      class="chip {{activeTab === 'EXCEPTION' ? 'chip-active' : ''}}"
      bindtap="onTabChange"
      data-tab="EXCEPTION"
    >
      异常
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-state">
    <text>加载中...</text>
  </view>

  <!-- 预约列表 -->
  <view wx:elif="{{activeTab === 'RESERVATIONS'}}">
    <view wx:if="{{reservations.length === 0}}" class="empty-state">
      <text>暂无预约记录</text>
    </view>
    <view wx:else>
      <view
        wx:for="{{reservations}}"
        wx:key="id"
        class="card"
      >
        <view class="card-title">{{getKeyName(item.keyId)}}</view>
        <view class="info-row">
          <text class="muted">预约时间</text>
          <text>{{formatDateTime(item.reservedAt)}}</text>
        </view>
        <view class="info-row">
          <text class="muted">过期时间</text>
          <text>{{formatDateTime(item.expiresAt)}}</text>
        </view>
        <view wx:if="{{item.purpose}}" class="info-row">
          <text class="muted">用途</text>
          <text>{{item.purpose}}</text>
        </view>
        <view class="info-row">
          <text class="muted">状态</text>
          <text class="tone-{{getStatusTone(item.status)}}">
            {{getReservationStatusLabel(item.status)}}
          </text>
        </view>
        <view
          wx:if="{{item.status === 'ACTIVE'}}"
          class="btn-ghost btn-small"
          bindtap="cancelReservation"
          data-id="{{item.id}}"
        >
          取消预约
        </view>
      </view>
    </view>
  </view>

  <!-- 借用中 -->
  <view wx:elif="{{activeTab === 'CURRENT'}}">
    <view wx:if="{{currentBorrows.length === 0}}" class="empty-state">
      <text>暂无借用</text>
    </view>
    <view wx:else>
      <view
        wx:for="{{currentBorrows}}"
        wx:key="id"
        class="card"
      >
        <view class="card-title">{{getKeyName(item.keyId)}}</view>
        <view class="info-row">
          <text class="muted">借出时间</text>
          <text>{{formatDateTime(item.borrowedAt)}}</text>
        </view>
        <view class="info-row">
          <text class="muted">应还时间</text>
          <text>{{formatDateTime(item.expectedReturnAt)}}</text>
        </view>
        <view wx:if="{{item.purpose}}" class="info-row">
          <text class="muted">用途</text>
          <text>{{item.purpose}}</text>
        </view>
        <view class="info-row">
          <text class="muted">状态</text>
          <text class="tone-{{getStatusTone(item.status)}}">
            {{getBorrowStatusLabel(item.status)}}
          </text>
        </view>
      </view>
    </view>
  </view>

  <!-- 已完成 -->
  <view wx:elif="{{activeTab === 'HISTORY'}}">
    <view wx:if="{{historyBorrows.length === 0}}" class="empty-state">
      <text>暂无历史记录</text>
    </view>
    <view wx:else>
      <view
        wx:for="{{historyBorrows}}"
        wx:key="id"
        class="card"
      >
        <view class="row-between">
          <view>
            <view>{{formatDate(item.borrowedAt)}} · {{getKeyName(item.keyId)}}</view>
            <view class="muted">
              {{formatTime(item.borrowedAt)}} - {{formatTime(item.returnedAt)}}
            </view>
            <view wx:if="{{item.purpose}}" class="muted small">{{item.purpose}}</view>
          </view>
          <view class="tone-green">已归还</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 异常 -->
  <view wx:elif="{{activeTab === 'EXCEPTION'}}">
    <view wx:if="{{exceptionBorrows.length === 0}}" class="empty-state">
      <text>暂无异常记录</text>
    </view>
    <view wx:else>
      <view
        wx:for="{{exceptionBorrows}}"
        wx:key="id"
        class="card"
      >
        <view class="card-title">{{getKeyName(item.keyId)}}</view>
        <view class="info-row">
          <text class="muted">借出时间</text>
          <text>{{formatDateTime(item.borrowedAt)}}</text>
        </view>
        <view class="info-row">
          <text class="muted">应还时间</text>
          <text>{{formatDateTime(item.expectedReturnAt)}}</text>
        </view>
        <view wx:if="{{item.purpose}}" class="info-row">
          <text class="muted">用途</text>
          <text>{{item.purpose}}</text>
        </view>
        <view class="info-row">
          <text class="muted">状态</text>
          <text class="tone-{{getStatusTone(item.status)}}">
            {{getBorrowStatusLabel(item.status)}}
          </text>
        </view>
      </view>
    </view>
  </view>
</view>
