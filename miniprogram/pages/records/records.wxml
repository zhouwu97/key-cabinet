<view class="page">
  <!-- 顶部三段式卡片 Tab (原型 .record-switch) -->
  <view class="record-switch">
    <view
      class="record-tab {{activeTab === 'CURRENT' ? 'active' : ''}}"
      bindtap="onTabChange"
      data-tab="CURRENT"
    >
      当前 {{currentTotalCount}}
    </view>
    <view
      class="record-tab {{activeTab === 'HISTORY' ? 'active' : ''}}"
      bindtap="onTabChange"
      data-tab="HISTORY"
    >
      历史 {{historyBorrows.length}}
    </view>
    <view
      class="record-tab {{activeTab === 'EXCEPTION' ? 'active' : ''}}"
      bindtap="onTabChange"
      data-tab="EXCEPTION"
    >
      异常 {{exceptionBorrows.length}}
    </view>
  </view>

  <!-- 1. 加载中状态 (Loading) -->
  <view wx:if="{{loading}}" class="card center-loading">
    <view class="loading-spinner"></view>
    <view class="loading-text">正在同步借还台账...</view>
  </view>

  <!-- 2. 当前任务 TAB (CURRENT: 待取预约 + 借用与归还中) -->
  <view wx:elif="{{activeTab === 'CURRENT'}}">
    <view wx:if="{{currentTotalCount === 0}}" class="card">
      <empty-state
        icon="/assets/icons/icon-key.svg"
        title="当前无进行中的借还任务"
        description="您当前没有待取钥预约或借出中的钥匙，如需使用请前往找钥匙"
        actionText="去预约钥匙"
        bindaction="goKeys"
      />
    </view>

    <view wx:else>
      <!-- 待取钥预约区 -->
      <view wx:if="{{activeReservations.length > 0}}" class="record-group">
        <section-header
          title="待取钥预约 ({{activeReservations.length}})"
          subTitle="请按预约时间到柜取钥匙"
        />
        <view wx:for="{{activeReservations}}" wx:key="id">
          <reservation-card
            reservation="{{item}}"
            showActions="{{true}}"
            bindpickup="onReservationPickup"
            bindcancel="onReservationCancel"
          />
        </view>
      </view>

      <!-- 借用与归还中区 -->
      <view wx:if="{{currentBorrows.length > 0}}" class="record-group">
        <section-header
          title="借用与归还中 ({{currentBorrows.length}})"
          subTitle="归还时请到对应钥匙柜扫码"
        />
        <view wx:for="{{currentBorrows}}" wx:key="id">
          <borrow-card
            borrow="{{item}}"
            showReturnBtn="{{true}}"
            bindreturn="onBorrowReturn"
          />
        </view>
      </view>
    </view>
  </view>

  <!-- 3. 历史记录 TAB (HISTORY) -->
  <view wx:elif="{{activeTab === 'HISTORY'}}">
    <view wx:if="{{historyBorrows.length === 0}}" class="card">
      <empty-state
        icon="/assets/icons/icon-record.svg"
        title="暂无历史归还记录"
        description="您完成的钥匙借还台账流水将在此展示"
      />
    </view>
    <view wx:else>
      <section-header
        title="已完成记录"
        subTitle="最近 90 天的借还流水"
      />
      <view wx:for="{{historyBorrows}}" wx:key="id">
        <borrow-card
          borrow="{{item}}"
          showReturnBtn="{{false}}"
        />
      </view>
    </view>
  </view>

  <!-- 4. 逾期/异常 TAB (EXCEPTION) -->
  <view wx:elif="{{activeTab === 'EXCEPTION'}}">
    <view wx:if="{{exceptionBorrows.length === 0}}" class="card">
      <empty-state
        icon="/assets/icons/icon-success.svg"
        title="记录良好，暂无异常与逾期"
        description="您的钥匙借还履约记录良好，请继续保持"
      />
    </view>
    <view wx:else>
      <section-header
        title="异常记录"
        subTitle="需关注的逾期或设备异常事件"
      />
      <view wx:for="{{exceptionBorrows}}" wx:key="id">
        <borrow-card
          borrow="{{item}}"
          showReturnBtn="{{item.canReturn}}"
          bindreturn="onBorrowReturn"
        />
      </view>
    </view>
  </view>
</view>
