<view wx:if="{{loading}}" class="page">
  <view class="center-loading">
    <view class="loading-spinner"></view>
    <view class="loading-text">正在加载个人资料...</view>
  </view>
</view>

<view wx:elif="{{!user}}" class="page">
  <view class="card empty-state">
    <text>当前未登录或无法获取身份</text>
  </view>
</view>

<view wx:else class="page">
  <!-- 用户身份主卡片 (.profile) -->
  <view class="profile card">
    <view class="avatar">{{avatarInitial || '用'}}</view>
    <view class="profile-center">
      <view class="profile-name-row">
        <text class="profile-name">{{user.name || '未填写姓名'}}</text>
        <status-badge
          text="{{user.role === 'ADMIN' ? '系统管理员' : (user.identityVerified ? '身份已核验' : '身份待核验')}}"
          tone="{{user.role === 'ADMIN' ? 'blue' : (user.identityVerified ? 'green' : 'orange')}}"
          dot="{{false}}"
        />
      </view>
      <view class="profile-meta">{{user.studentNo || '--'}} · {{user.department || '未绑定学院'}}</view>
    </view>
    <view class="verify-link" bindtap="goIdentityBind">
      {{user.identityVerified ? '已完善' : '去完善'}}
    </view>
  </view>

  <!-- 三等分借用与履约统计看板 (.stats) -->
  <view class="stats card">
    <view class="stat" bindtap="goCurrentBorrows">
      <view class="stat-num {{currentBorrowCount > 0 ? 'tone-blue' : ''}}">{{currentBorrowCount}}</view>
      <text class="stat-label">借用中</text>
    </view>
    <view class="stat" bindtap="goReservations">
      <view class="stat-num {{activeReservationCount > 0 ? 'tone-orange' : ''}}">{{activeReservationCount}}</view>
      <text class="stat-label">待取钥</text>
    </view>
    <view class="stat" bindtap="goHistory">
      <view class="stat-num">{{totalBorrowCount}}</view>
      <text class="stat-label">累计借用</text>
    </view>
  </view>

  <!-- 个人身份与认证 (.menu-card) -->
  <view class="menu-card card">
    <view class="menu-item" bindtap="goIdentityBind">
      <view class="menu-icon">🪪</view>
      <text class="menu-label">身份认证信息</text>
      <view class="menu-extra">
        <text class="tag-dev">
          {{user.identityVerified ? '已核验' : (user.profileCompleted ? '待管理员核验' : '去完善 ›')}}
        </text>
      </view>
    </view>
  </view>

  <!-- 常见服务与使用守则 (.menu-card) -->
  <view class="menu-card card">
    <view class="menu-item" bindtap="showHelpModal">
      <view class="menu-icon">💡</view>
      <text class="menu-label">借还流程与常见问题</text>
      <text class="chev">›</text>
    </view>
    <view class="menu-item" bindtap="showLocationsModal">
      <view class="menu-icon">🏢</view>
      <text class="menu-label">钥匙柜分布与位置</text>
      <text class="chev">›</text>
    </view>
    <view class="menu-item" bindtap="showRulesModal">
      <view class="menu-icon">📜</view>
      <text class="menu-label">实验室钥匙使用守则</text>
      <text class="chev">›</text>
    </view>
  </view>

  <!-- 管理员与系统控制台 (仅管理员可见) -->
  <view wx:if="{{user.role === 'ADMIN'}}" class="menu-card card">
    <view class="menu-item" bindtap="goAdmin">
      <view class="menu-icon">🛠️</view>
      <text class="menu-label">管理中心 · 开发诊断控制台</text>
      <view class="menu-extra">
        <text class="tag-dev">管理员</text>
        <text class="chev">›</text>
      </view>
    </view>
  </view>

  <!-- 系统关于说明 (.menu-card) -->
  <view class="menu-card card">
    <view class="menu-item" bindtap="showAbout">
      <view class="menu-icon">ℹ️</view>
      <text class="menu-label">关于钥匙借还</text>
      <text class="chev">›</text>
    </view>
  </view>
</view>
