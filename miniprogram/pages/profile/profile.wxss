.page {
  padding: 24rpx;
  background-color: #f5f6f8;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 用户概览卡片 */
.user-hero-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.user-avatar-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #eaf1ff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-avatar {
  font-size: 52rpx;
}

.user-info {
  flex: 1;
}

.user-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.user-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2329;
}

.user-meta {
  font-size: 24rpx;
  color: #8a919f;
}

/* 统计看板卡片 */
.stats-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0;
}

.stats-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2329;
  margin-bottom: 4rpx;
}

.stats-label {
  font-size: 22rpx;
  color: #8a919f;
}

.stats-divider {
  width: 2rpx;
  height: 48rpx;
  background-color: #f0f1f3;
}

/* 菜单列表卡片 */
.menu-section {
  padding: 8rpx 24rpx;
  margin-bottom: 24rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 8rpx;
  border-bottom: 1px solid #f0f1f3;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.menu-icon {
  font-size: 32rpx;
}

.menu-text {
  font-size: 28rpx;
  color: #1f2329;
  font-weight: 500;
}

.menu-item-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tag-dev {
  font-size: 20rpx;
  color: #2f6bff;
  background-color: #eaf1ff;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-weight: 500;
}

.menu-arrow {
  font-size: 32rpx;
  color: #c9cdd4;
  line-height: 1;
}
