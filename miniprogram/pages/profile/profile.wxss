.page {
  padding: 24rpx;
  background-color: var(--kc-bg, #f5f6f8);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 用户主卡片 (.profile) */
.profile {
  padding: 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: var(--kc-radius-lg, 32rpx);
  background-color: var(--kc-primary-soft, #eef3ff);
  color: var(--kc-primary, #2f67f6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: 38rpx;
  flex-shrink: 0;
}

.profile-center {
  flex: 1;
}

.profile-name-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 8rpx;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 750;
  color: var(--kc-text-primary, #20242c);
  letter-spacing: -0.2rpx;
}

.profile-meta {
  color: var(--kc-text-muted, #9299a6);
  font-size: 24rpx;
}

.verify-link {
  color: var(--kc-primary, #2f67f6);
  font-size: 24rpx;
  font-weight: 600;
  padding: 8rpx 0;
  flex-shrink: 0;
}

/* 履约统计看板 (.stats) */
.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  padding: 30rpx 12rpx;
  margin-bottom: 24rpx;
}

.stat {
  text-align: center;
  position: relative;
}

.stat + .stat::before {
  content: "";
  position: absolute;
  left: 0;
  top: 4rpx;
  bottom: 4rpx;
  width: 1rpx;
  background-color: var(--kc-line, #e7e9ee);
}

.stat-num {
  display: block;
  font-size: 38rpx;
  font-weight: 750;
  line-height: 1.2;
  color: var(--kc-text-primary, #20242c);
}

.stat-label {
  color: var(--kc-text-muted, #9299a6);
  font-size: 22rpx;
  margin-top: 6rpx;
  display: block;
}

/* 分组菜单卡片 (.menu-card) */
.menu-card {
  overflow: hidden;
  padding: 0;
  margin-bottom: 24rpx;
}

.menu-item {
  min-height: 104rpx;
  width: 100%;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.menu-item + .menu-item {
  border-top: 1rpx solid var(--kc-line, #e7e9ee);
}

.menu-icon {
  width: 54rpx;
  display: flex;
  align-items: center;
}

.menu-icon-img {
  width: 36rpx;
  height: 36rpx;
  display: block;
}

.menu-label {
  font-size: 26rpx;
  font-weight: 550;
  color: var(--kc-text-primary, #20242c);
  flex: 1;
}

.menu-extra {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.tag-dev {
  font-size: 22rpx;
  color: var(--kc-text-muted, #9299a6);
}

.chev {
  color: #b6bcc6;
  font-size: 36rpx;
  line-height: 1;
  font-weight: 300;
}

/* 加载状态 */
.center-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e1e3e6;
  border-top-color: var(--kc-primary, #2f67f6);
  border-radius: 50%;
  animation: spin 0.8s infinite linear;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 26rpx;
  color: var(--kc-text-muted, #9299a6);
}

.logout-button {
  margin: 28rpx 0 40rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #fff;
  color: #e05252;
  font-size: 26rpx;
}
