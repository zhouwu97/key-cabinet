<view class="page">
  <view wx:if="{{loading}}" class="loading-state card">
    <text>正在加载钥匙信息...</text>
  </view>

  <view wx:elif="{{loadError}}" class="card">
    <error-state title="暂时无法预约" message="{{loadError}}" bindretry="retryLoad" />
  </view>

  <view wx:elif="{{createdReservation}}" class="card form-card">
    <view class="key-room-title">{{createdReservation.status === 'PENDING' ? '预约已提交，等待审批' : '预约成功'}}</view>
    <view class="result-description">{{createdReservation.status === 'PENDING' ? '管理员审批通过后，请在取钥窗口内到指定柜机扫码。审批结果和拒绝原因可在借还记录中查看。' : '请在取钥窗口内到指定柜机扫码取钥，超时未取将自动过期。'}}</view>
    <view class="result-description">{{keyDisplayName}} · {{deviceName}}</view>
    <view class="result-description">
      <view>取钥窗口：{{createdPickupWindowText}}</view>
      <view>预计归还：{{createdReturnText}}</view>
    </view>
    <button class="submit-btn" bindtap="goRecords">查看预约与取钥</button>
  </view>

  <view wx:else>
    <!-- 钥匙基本信息头卡片 -->
    <view class="key-header-card card">
      <view class="key-header-row">
        <view class="key-room-title">{{keyDisplayName || key.name}}</view>
        <view class="avail-badge">● 可预约</view>
      </view>
      <view class="key-cabinet-info">
		<text class="cab-loc">{{deviceName}} · {{deviceLocation}}</text>
        <text class="cab-dot">·</text>
        <text class="cab-slot">槽位 {{key.slotId}}</text>
      </view>
    </view>

    <!-- 预约核心表单卡片 -->
    <view class="card form-card">
      <!-- 借用用途 -->
      <view class="form-group">
        <view class="form-label">
          <text class="label-title">借用用途</text>
          <text class="label-req">*</text>
        </view>
        <view class="tag-selector">
          <view
            wx:for="{{purposeTags}}"
            wx:key="*this"
            class="purpose-tag {{selectedTag === item ? 'tag-selected' : ''}}"
            bindtap="onSelectTag"
            data-tag="{{item}}"
          >
            {{item}}
          </view>
        </view>
        <textarea
          class="purpose-input"
          placeholder="请输入具体用途说明..."
          placeholder-class="input-ph"
          value="{{purpose}}"
          bindinput="onPurposeInput"
          maxlength="100"
        />
      </view>

      <!-- 取钥时间说明 -->
      <view class="info-cell">
        <text class="cell-label">到柜取钥窗口</text>
        <text class="cell-val">提交后 30 分钟内</text>
      </view>

      <!-- 预计归还时间 -->
      <view class="form-group">
        <view class="form-label">
          <text class="label-title">预计归还时间</text>
          <text class="label-req">*</text>
        </view>
        <picker mode="date" value="{{returnDate}}" start="{{minReturnDate}}" bindchange="onReturnDateChange">
          <view class="picker-selector date-selector">
            <text class="picker-text">{{returnDate}}</text>
            <text class="picker-arrow">修改日期 ›</text>
          </view>
        </picker>
        <picker
          mode="time"
          value="{{returnTime}}"
          bindchange="onReturnTimeChange"
        >
          <view class="picker-selector">
            <text class="picker-text">{{returnTime}}</text>
            <text class="picker-arrow">修改时间 ›</text>
          </view>
        </picker>
      </view>

      <!-- 审批方式 -->
      <view class="info-cell">
        <text class="cell-label">审批方式</text>
		<view class="{{key.requiresApproval ? 'cell-tag-orange' : 'cell-tag-green'}}">
		  {{key.requiresApproval ? '需要管理员审批' : '免审批 · 即约即取'}}
		</view>
      </view>
    </view>

    <!-- 守则同意与确认 -->
    <view class="rules-row" bindtap="toggleRulesAgree">
      <view class="checkbox {{agreedRules ? 'checked' : ''}}">
        <text wx:if="{{agreedRules}}">✓</text>
      </view>
      <text class="rules-text">我已阅读并同意《实验室钥匙借用与安全守则》</text>
    </view>

    <view class="submit-wrap">
      <button
        class="btn-primary center submit-btn {{submitting || !agreedRules ? 'disabled' : ''}}"
        loading="{{submitting}}"
        disabled="{{submitting || !agreedRules}}"
        bindtap="submitReservation"
      >
        确认预约
      </button>
    </view>
  </view>
</view>
