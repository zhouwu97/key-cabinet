<view class="page">
  <!-- 离线状态提示横幅 (Offline State) -->
  <view wx:if="{{isCabinetOffline}}" class="offline-banner">
    <image class="offline-icon-img" src="/assets/icons/icon-warning.svg" mode="aspectFit" />
	<text class="offline-text">部分钥匙柜离线或信息缺失，仍可浏览钥匙但暂无法现场取钥</text>
  </view>

  <!-- 搜索输入框 -->
  <view class="searchbar">
    <view class="search-icon-box">
      <view class="search-glass"></view>
      <view class="search-handle"></view>
    </view>
    <input
      class="search-input"
      placeholder="搜索房间号或钥匙名称"
      placeholder-class="search-placeholder"
      bindinput="onSearchInput"
      value="{{searchKeyword}}"
    />
    <view wx:if="{{searchKeyword}}" class="clear-btn" bindtap="clearSearch">✕</view>
  </view>

  <!-- 状态分类筛选分段选择器 (Segmented Control) -->
  <view class="segmented">
    <view
      class="seg-btn {{activeFilter === 'ALL' ? 'active' : ''}}"
      bindtap="onFilterTap"
      data-filter="ALL"
    >
      全部 {{keys.length}}
    </view>
    <view
      class="seg-btn {{activeFilter === 'AVAILABLE' ? 'active' : ''}}"
      bindtap="onFilterTap"
      data-filter="AVAILABLE"
    >
      可预约 {{availableCount}}
    </view>
    <view
      class="seg-btn {{activeFilter === 'BORROWED' ? 'active' : ''}}"
      bindtap="onFilterTap"
      data-filter="BORROWED"
    >
      已借出 {{borrowedCount}}
    </view>
  </view>

  <!-- 1. 加载中状态 (Loading) -->
  <view wx:if="{{loading}}" class="card center-loading">
    <view class="loading-spinner"></view>
    <view class="loading-text">正在同步钥匙状态...</view>
  </view>

  <!-- 2. 错误状态 (Error) -->
  <view wx:elif="{{hasError}}" class="card">
    <error-state
      title="钥匙列表加载失败"
      message="暂时无法获取钥匙柜数据，请检查网络后重试"
      retryText="重新加载"
      bindretry="loadKeys"
    />
  </view>

  <!-- 3. 空结果状态 (Empty) -->
  <view wx:elif="{{filteredKeys.length === 0}}" class="card">
    <empty-state
      icon="/assets/icons/icon-search.svg"
      title="{{searchKeyword ? '未找到相关钥匙' : '暂无相关钥匙'}}"
      description="{{searchKeyword ? '没有找到包含“' + searchKeyword + '”的钥匙，请检查房间号或名称后重试' : '当前分类下暂无钥匙'}}"
      actionText="{{searchKeyword ? '清空搜索' : ''}}"
      bindaction="clearSearch"
    />
  </view>

  <!-- 4. 正常卡片列表 (Normal) -->
  <view wx:else class="key-list">
    <view wx:for="{{filteredKeys}}" wx:key="id">
      <key-card
        keyItem="{{item}}"
        bindtapcard="onKeyCardTap"
      />
    </view>
  </view>
</view>
