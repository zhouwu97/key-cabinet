.page {
  padding: 24rpx;
  background-color: #f5f6f8;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 离线通知横幅 */
.offline-banner {
  background-color: #fff9e6;
  border: 1px solid #ffe58f;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.offline-icon {
  font-size: 32rpx;
}

.offline-text {
  font-size: 24rpx;
  color: #d48806;
  line-height: 1.4;
  flex: 1;
}

/* 搜索框 */
.search-container {
  margin-bottom: 20rpx;
}

.search-input-box {
  background-color: #ffffff;
  border-radius: 999rpx;
  padding: 16rpx 28rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  border: 1px solid #edf0f5;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
  opacity: 0.6;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1f2329;
}

.search-placeholder {
  color: #8a919f;
  font-size: 26rpx;
}

.clear-btn {
  font-size: 26rpx;
  color: #8a919f;
  padding: 4rpx 12rpx;
}

/* 筛选标签 */
.chips-container {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.chip {
  background-color: #ffffff;
  color: #646a73;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.03);
  transition: all 0.2s ease;
  font-weight: 500;
}

.chip-active {
  background-color: #2f6bff;
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(47, 107, 255, 0.25);
}

/* 加载中 */
.center-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e1e3e6;
  border-top-color: #2f6bff;
  border-radius: 50%;
  animation: spin 0.8s infinite linear;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 26rpx;
  color: #8a919f;
}

.key-list {
  display: flex;
  flex-direction: column;
}
