.page {
  padding: 24rpx;
  background-color: var(--kc-bg, #f5f6f8);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 离线通知横幅 */
.offline-banner {
  background-color: #fff9e6;
  border: 1rpx solid #ffe58f;
  border-radius: var(--kc-radius-md, 20rpx);
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.offline-icon-img {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.offline-text {
  font-size: 24rpx;
  color: #d48806;
  line-height: 1.4;
  flex: 1;
}

/* 原型搜索条 (Search Bar) */
.searchbar {
  height: 88rpx;
  background-color: #ffffff;
  border: 1rpx solid var(--kc-line, #e7e9ee);
  border-radius: var(--kc-radius-md, 24rpx);
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 14rpx rgba(17, 25, 40, 0.03);
  box-sizing: border-box;
}

.search-icon-box {
  width: 34rpx;
  height: 34rpx;
  position: relative;
  flex-shrink: 0;
}

.search-glass {
  width: 20rpx;
  height: 20rpx;
  border: 3rpx solid #8a93a1;
  border-radius: 50%;
  position: absolute;
  top: 2rpx;
  left: 2rpx;
}

.search-handle {
  width: 10rpx;
  height: 3rpx;
  background-color: #8a93a1;
  position: absolute;
  bottom: 6rpx;
  right: 4rpx;
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: var(--kc-text-primary, #20242c);
  height: 100%;
}

.search-placeholder {
  color: #a1a8b3;
  font-size: 26rpx;
}

.clear-btn {
  font-size: 26rpx;
  color: #8a93a1;
  padding: 8rpx 12rpx;
}

/* 原型分段选择器 (Segmented Control) */
.segmented {
  display: flex;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.seg-btn {
  border: 1rpx solid var(--kc-line, #e7e9ee);
  color: var(--kc-text-secondary, #5e6673);
  background-color: #ffffff;
  height: 68rpx;
  line-height: 66rpx;
  padding: 0 26rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
  box-sizing: border-box;
  text-align: center;
  transition: all 0.15s ease;
}

.seg-btn.active {
  color: #ffffff;
  background-color: var(--kc-primary, #2f67f6);
  border-color: var(--kc-primary, #2f67f6);
}

/* 加载状态 */
.center-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e1e3e6;
  border-top-color: var(--kc-primary, #2f67f6);
  border-radius: 50%;
  animation: spin 0.8s infinite linear;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 26rpx;
  color: var(--kc-text-muted, #9299a6);
}

/* 列表网格 */
.key-list {
  display: flex;
  flex-direction: column;
}
