.page {
  padding: 24rpx;
  background-color: var(--kc-bg, #f5f6f8);
  min-height: 100vh;
  box-sizing: border-box;
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--kc-line, #e7e9ee);
}

.room-title {
  font-size: 36rpx;
  font-weight: 750;
  color: var(--kc-text-primary, #20242c);
  letter-spacing: -0.4rpx;
}

.card-section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--kc-text-primary, #20242c);
  margin-bottom: 18rpx;
}

.desc-text {
  font-size: 26rpx;
  color: var(--kc-text-secondary, #5e6673);
  line-height: 1.6;
}

.info-label {
  font-size: 26rpx;
  color: var(--kc-text-muted, #9299a6);
}

.info-val {
  font-size: 26rpx;
  font-weight: 550;
  color: var(--kc-text-primary, #20242c);
}

.rule-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.rule-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.rule-num {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background-color: var(--kc-primary-soft, #eef3ff);
  color: var(--kc-primary, #2f67f6);
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.rule-text {
  font-size: 26rpx;
  color: var(--kc-text-secondary, #5e6673);
  line-height: 1.5;
  flex: 1;
}

.action-footer {
  margin: 32rpx 0 24rpx;
}

/* 调试面板 */
.debug-card {
  background-color: var(--kc-surface-2, #f8f9fb);
  border: 1rpx dashed var(--kc-line-strong, #d9dde5);
  margin-top: 32rpx;
}

.debug-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  font-weight: 650;
  color: var(--kc-primary, #2f67f6);
  margin-bottom: 16rpx;
}

.debug-icon-img {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.mono-val {
  font-family: monospace;
  font-size: 24rpx;
  color: var(--kc-text-secondary, #5e6673);
}

.dev-toggle-link {
  text-align: center;
  font-size: 24rpx;
  color: var(--kc-text-muted, #9299a6);
  padding: 16rpx;
  margin-top: 8rpx;
}
