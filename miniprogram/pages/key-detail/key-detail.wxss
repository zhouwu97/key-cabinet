.page {
  padding: 24rpx;
  background-color: #f5f6f8;
  min-height: 100vh;
  box-sizing: border-box;
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1px solid #f0f1f3;
}

.room-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2329;
}

.card-section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
  margin-bottom: 16rpx;
}

.desc-text {
  font-size: 26rpx;
  color: #646a73;
  line-height: 1.6;
}

.info-label {
  font-size: 26rpx;
  color: #8a919f;
}

.info-val {
  font-size: 26rpx;
  font-weight: 500;
  color: #1f2329;
}

.rule-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.rule-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.rule-num {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background-color: #f0f4ff;
  color: #2f6bff;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.rule-text {
  font-size: 26rpx;
  color: #646a73;
  line-height: 1.5;
  flex: 1;
}

.action-footer {
  margin: 32rpx 0 24rpx;
}

/* 调试面板 */
.debug-card {
  background-color: #fafbfc;
  border: 1px dashed #d0d5dd;
  margin-top: 32rpx;
}

.debug-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #2f6bff;
  margin-bottom: 16rpx;
}

.mono-val {
  font-family: monospace;
  font-size: 24rpx;
  color: #4e5969;
}

.dev-toggle-link {
  text-align: center;
  font-size: 24rpx;
  color: #8a919f;
  padding: 16rpx;
  margin-top: 8rpx;
}
