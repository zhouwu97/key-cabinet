<view class="page">
  <view wx:if="{{loading}}" class="card center-loading">
    <view class="loading-spinner"></view>
    <view class="loading-text">加载钥匙详情中...</view>
  </view>

  <view wx:elif="{{!key}}" class="card">
    <empty-state
      icon="🔑"
      title="钥匙不存在"
      description="未找到该钥匙信息，可能已被移除或停用"
      actionText="返回列表"
      bindaction="goBack"
    />
  </view>

  <view wx:else>
    <!-- 普通用户核心卡片：名称、状态、所在柜 -->
    <view class="card">
      <view class="detail-header">
        <view class="room-title">{{key.roomNo}} · {{key.name}}</view>
        <status-badge text="{{statusLabel}}" tone="{{statusTone}}" dot="{{true}}" />
      </view>

      <view class="info-row">
        <text class="info-label">所在钥匙柜</text>
        <text class="info-val">{{deviceName}}</text>
      </view>

      <view class="info-row">
        <text class="info-label">借用审批规则</text>
        <text class="info-val tone-blue">{{key.requiresApproval ? '需管理员审批' : '免审批 · 即约即取'}}</text>
      </view>

      <view class="info-row">
        <text class="info-label">取钥有效窗口</text>
        <text class="info-val">预约成功后 2 小时内有效</text>
      </view>

      <view class="info-row">
        <text class="info-label">服务状态</text>
        <text class="info-val {{key.enabled ? 'tone-green' : 'tone-red'}}">
          {{key.enabled ? '正常服务中' : '已停用维护'}}
        </text>
      </view>
    </view>

    <!-- 房间与用途说明 -->
    <view wx:if="{{key.description}}" class="card">
      <view class="card-section-title">房间与钥匙说明</view>
      <view class="desc-text">{{key.description}}</view>
    </view>

    <!-- 自助借还使用指南 -->
    <view class="card">
      <view class="card-section-title">自助借还流程与守则</view>
      <view class="rule-list">
        <view class="rule-item">
          <text class="rule-num">1</text>
          <text class="rule-text">手机端提交预约申请，锁定钥匙配额。</text>
        </view>
        <view class="rule-item">
          <text class="rule-num">2</text>
          <text class="rule-text">在有效取钥窗口期内，前往钥匙柜并点击「现场取钥」。</text>
        </view>
        <view class="rule-item">
          <text class="rule-num">3</text>
          <text class="rule-text">使用完毕后放入归还口，系统通过 RFID 自动核验入库结算。</text>
        </view>
        <view class="rule-item">
          <text class="rule-num">4</text>
          <text class="rule-text">请在规定时间内归还，严禁私自转借或带离校园。</text>
        </view>
      </view>
    </view>

    <!-- 底部操作按钮 -->
    <view class="action-footer">
      <view
        wx:if="{{canReserve}}"
        class="btn-primary"
        bindtap="goReserve"
      >
        立即预约借用
      </view>
      <view
        wx:else
        class="btn-disabled"
      >
        当前不可预约 ({{statusLabel}})
      </view>
    </view>

    <!-- 管理员/开发模式底层硬件诊断 (折叠面板) -->
    <view wx:if="{{isAdminOrDev}}" class="card debug-card">
      <view class="debug-title">⚙️ 底层硬件与物理槽位 (开发/管理员视图)</view>
      <view class="info-row">
        <text class="info-label">钥匙 ID</text>
        <text class="mono-val">{{key.id}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">物理槽位</text>
        <text class="mono-val">{{slot ? '#' + slot.slotNo + ' (' + slot.id + ')' : key.slotId}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">槽位物理在位检测</text>
        <text class="{{slot && slot.presence === 'PRESENT' ? 'tone-green' : 'tone-orange'}}">
          ● {{presenceLabel}}
        </text>
      </view>
      <view class="info-row">
        <text class="info-label">RFID 芯片 UID</text>
        <text class="mono-val">{{key.rfidTag || '未绑定'}}</text>
      </view>
    </view>

    <view class="dev-toggle-link" bindtap="toggleDevMode">
      <text>{{isAdminOrDev ? '▼ 收起硬件底层诊断信息' : '▶ 展开硬件底层诊断信息 (调试模式)'}}</text>
    </view>
  </view>
</view>
