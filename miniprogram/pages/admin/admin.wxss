.page {
  padding: 24rpx;
  background-color: #f5f6f8;
  min-height: 100vh;
  box-sizing: border-box;
}

.picker-box {
  background-color: #f8fafc;
  border: 1rpx solid #cbd5e1;
  padding: 24rpx;
  border-radius: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-value {
  color: #2f6bff;
  font-weight: 600;
}

.mt-8 {
  margin-top: 16rpx;
}

.mt-16 {
  margin-top: 24rpx;
}

.test-btn-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.small-btn {
  padding: 16rpx 0;
  font-size: 26rpx;
  margin: 0;
  border-radius: 12rpx;
}

.slot-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 16rpx;
  margin-top: 16rpx;
}

.slot-cell {
  padding: 16rpx 8rpx;
  border-radius: 12rpx;
  text-align: center;
  border: 1rpx solid #e2e8f0;
}

.slot-present {
  background-color: #e6f8f1;
  border-color: #00b578;
  color: #00b578;
}

.slot-absent {
  background-color: #fff4e8;
  border-color: #ff8f1f;
  color: #ff8f1f;
}

.slot-disabled {
  background-color: #f0f1f3;
  border-color: #c9cdd4;
  color: #8a919f;
}

.slot-num {
  font-size: 20rpx;
  font-weight: 600;
}

.slot-key {
  font-size: 22rpx;
  font-weight: 700;
  margin: 4rpx 0;
}

.slot-status {
  font-size: 18rpx;
}
