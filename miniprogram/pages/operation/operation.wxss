.page {
  padding: 24rpx;
  background-color: #f5f6f8;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 顶部操作概览卡片 */
.hero-op-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.op-header-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.op-title-wrap {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.op-action-tag {
  margin-bottom: 4rpx;
}

.op-target-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2329;
}

.op-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1px solid #f0f1f3;
  font-size: 26rpx;
}

.op-label {
  color: #8a919f;
}

.op-value {
  color: #1f2329;
  font-weight: 500;
}

/* 行动指引横幅 */
.guidance-banner {
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  transition: all 0.3s ease;
}

.guidance-active {
  background: linear-gradient(135deg, #eef4ff 0%, #e0ecff 100%);
  border: 1px solid #c8dcff;
}

.guidance-finish {
  background: linear-gradient(135deg, #ebf9f3 0%, #d6f4e6 100%);
  border: 1px solid #a3e7c8;
}

.guidance-error {
  background: linear-gradient(135deg, #fff1f0 0%, #ffe2e0 100%);
  border: 1px solid #ffccc7;
}

.guidance-icon {
  font-size: 36rpx;
  line-height: 1;
}

.guidance-content {
  flex: 1;
}

.guidance-main {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
  margin-bottom: 4rpx;
}

.guidance-sub {
  font-size: 24rpx;
  color: #646a73;
  line-height: 1.4;
}

/* 步进器容器 */
.stepper-section {
  margin-bottom: 24rpx;
}

/* 完成结算卡片 */
.finish-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.finish-title-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.finish-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background-color: #00b578;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
}

.finish-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #00b578;
}

.finish-desc {
  font-size: 26rpx;
  color: #646a73;
  line-height: 1.5;
  margin-bottom: 32rpx;
  max-width: 520rpx;
  margin-left: auto;
  margin-right: auto;
}

.action-buttons {
  display: flex;
  flex-direction: column;
}

/* 异常卡片 */
.error-op-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  text-align: center;
}

.error-action-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #ee0a24;
}

.error-action-desc {
  font-size: 26rpx;
  color: #8a919f;
  margin-top: 8rpx;
}

.center-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}
