<view class="page">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="card center-loading">
    <view class="loading-spinner"></view>
    <view class="loading-text">正在建立设备安全会话...</view>
  </view>

  <!-- 错误且无操作实体状态 -->
  <view wx:elif="{{hasError && !operation}}" class="card">
    <error-state
      title="未找到待执行的操作"
      message="{{errorMessage || '该设备操作会话可能已结束或无效'}}"
      retryText="返回系统首页"
      bindretry="goHome"
    />
  </view>

  <!-- 核心展示操作面板 -->
  <view wx:else>
    <!-- 头部操作卡片 -->
    <view class="card hero-op-card">
      <view class="op-header-row">
        <view class="op-title-wrap">
          <view class="op-action-tag">
            <status-badge
              text="{{operation.action === 'PICKUP' ? '取钥中' : '归还中'}}"
              tone="{{isFinished ? 'green' : (hasError ? 'red' : 'blue')}}"
              dot="{{true}}"
            />
          </view>
          <view class="op-target-name">
            {{key ? key.roomNo + ' · ' + key.name : '智能钥匙柜操作'}}
          </view>
        </view>
      </view>

      <view class="op-info-row">
        <text class="op-label">执行设备</text>
        <text class="op-value">{{deviceName}}</text>
      </view>
    </view>

    <!-- 动态行动指引横幅 (当前发生什么 / 下一步我需要做什么) -->
    <view class="guidance-banner {{isFinished ? 'guidance-finish' : (hasError ? 'guidance-error' : 'guidance-active')}}">
      <view class="guidance-icon">
        <text wx:if="{{isFinished}}">🎉</text>
        <text wx:elif="{{hasError}}">⚠️</text>
        <text wx:else>💡</text>
      </view>
      <view class="guidance-content">
        <view class="guidance-main">{{userPromptTitle}}</view>
        <view class="guidance-sub">{{userPromptDesc}}</view>
      </view>
    </view>

    <!-- 竖向旗舰级步骤步进器 (Operation Stepper) -->
    <view class="stepper-section">
      <operation-stepper
        steps="{{steps}}"
        currentStep="{{currentStepNumber}}"
        totalSteps="6"
        actionTitle="{{operation.action === 'PICKUP' ? '取钥流转时序' : '归还流转时序'}}"
      />
    </view>

    <!-- 成功结算卡片 (完成态) -->
    <view wx:if="{{isFinished}}" class="card finish-card">
      <view class="finish-title-row">
        <text class="finish-icon">✓</text>
        <text class="finish-title">{{operation.action === 'PICKUP' ? '钥匙已成功取出' : '钥匙已成功归还'}}</text>
      </view>
      <view class="finish-desc">
        {{operation.action === 'PICKUP' ? '借用计时已开始生效，使用完毕后请在应还时间前放入归还口。' : 'RFID 芯片核验通过，借还单已自动结算完毕。'}}
      </view>
      <view class="action-buttons">
        <view class="btn-primary" bindtap="goRecords">查看借还记录</view>
        <view class="btn-ghost mt-12" bindtap="goHome">返回系统首页</view>
      </view>
    </view>

    <!-- 失败重试/返回按钮 -->
    <view wx:elif="{{hasError}}" class="card error-op-card">
      <view class="error-action-title">操作未成功完成</view>
      <view class="error-action-desc">{{errorMessage || '设备响应异常，请重新发起或联系现场管理员'}}</view>
      <view class="btn-primary mt-16" bindtap="goHome">返回首页重新发起</view>
    </view>
  </view>
</view>
