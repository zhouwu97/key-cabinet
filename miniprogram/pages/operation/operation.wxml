<view class="page">
  <view class="card">
    <view class="card-title">设备操作 · 103 实验室</view>
    <view class="info-row"><text class="muted">当前事件</text><text>{{latest}}</text></view>
    <view class="muted" wx:if="{{log.length === 0}}">点击下方按钮走一遍 Mock 事件时序（PRD 第三十五节）</view>
    <view wx:for="{{log}}" wx:key="*this" class="muted">· {{item}}</view>
  </view>

  <view class="btn-primary center" bindtap="demoBorrow">演示：发起取钥（Mock）</view>
  <view class="placeholder-note">骨架占位 · 步骤条/异常处理/归还流程待实现</view>
</view>
