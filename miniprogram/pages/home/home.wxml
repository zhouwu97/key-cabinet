<view class="page">
  <!-- 用户待办与问候首屏 -->
  <view class="user-greeting-card">
    <view class="greeting-row">
      <view class="greeting-left">
        <view class="greeting-title">{{greetingText}}，{{userName}}</view>
        <view class="greeting-sub">
          今天有 <text class="pending-num">{{pendingTaskCount}}</text> 项待处理
        </view>
      </view>
      <view
        wx:if="{{user && !user.profileCompleted}}"
        class="bind-prompt-tag"
        bindtap="goIdentityBind"
      >
        去完善身份 ›
      </view>
    </view>
  </view>

  <!-- P0: 未完成设备操作中断恢复横幅 -->
  <view
    wx:if="{{activeOperation}}"
    class="active-op-card"
    bindtap="resumeOperation"
  >
    <view class="active-op-header">
      <view class="active-op-pulse"></view>
      <text class="active-op-title">检测到未完成设备操作</text>
      <text class="active-op-badge">执行中</text>
    </view>
    <view class="active-op-body">
      <text class="active-op-name">
        {{activeOperationKey ? activeOperationKey.roomNo + ' ' + activeOperationKey.name : '钥匙操作'}}
      </text>
      <text class="active-op-action">
        ({{activeOperation.action === 'PICKUP' ? '正在取钥' : '正在归还'}})
      </text>
    </view>
    <view class="active-op-btn">点击继续查看进度与恢复 ›</view>
  </view>

  <!-- P4 (前置主行动): 扫码使用钥匙柜 -->
  <view class="scan-cta-card" bindtap="onMainScanTap">
    <view class="scan-cta-content">
      <view class="scan-cta-left">
        <view class="scan-cta-title">扫码使用钥匙柜</view>
        <view class="scan-cta-desc">到柜后扫码核验，快速现场取钥或归还</view>
      </view>
      <view class="scan-cta-badge">
        <text class="scan-cta-icon">📷</text>
        <text>扫一扫</text>
      </view>
    </view>
  </view>

  <!-- P1: 逾期借用待处理 -->
  <view wx:if="{{overdueBorrows.length > 0}}" class="section-block">
    <section-header
      title="逾期急需处理 ({{overdueBorrows.length}})"
      subTitle="钥匙已超过约定归还时间，请尽快到柜扫码归还"
    />
    <view wx:for="{{overdueBorrows}}" wx:key="id">
      <borrow-card
        borrow="{{item}}"
        showReturnBtn="{{true}}"
        bindreturn="onBorrowCardReturn"
      />
    </view>
  </view>

  <!-- P2: 待取钥预约 -->
  <view wx:if="{{activeReservations.length > 0}}" class="section-block">
    <section-header
      title="待取钥预约 ({{activeReservations.length}})"
      subTitle="请在取钥时间窗口内前往钥匙柜扫码取钥"
      actionText="全部预约"
      bindaction="goMyReservations"
    />
    <view wx:for="{{activeReservations}}" wx:key="id">
      <reservation-card
        reservation="{{item}}"
        showActions="{{true}}"
        bindpickup="onReservationCardPickup"
        bindcancel="onReservationCardCancel"
      />
    </view>
  </view>

  <!-- P3: 当前正常借用 -->
  <view wx:if="{{normalBorrows.length > 0}}" class="section-block">
    <section-header
      title="当前借用中 ({{normalBorrows.length}})"
      subTitle="请留意归还时间，使用完毕请按时归还"
      actionText="全部记录"
      bindaction="goRecords"
    />
    <view wx:for="{{normalBorrows}}" wx:key="id">
      <borrow-card
        borrow="{{item}}"
        showReturnBtn="{{true}}"
        bindreturn="onBorrowCardReturn"
      />
    </view>
  </view>

  <!-- P5: 快捷入口 (横向简约排列) -->
  <view class="section-block">
    <section-header title="快捷服务" subTitle="常用功能与服务" />
    <view class="quick-row card">
      <view class="quick-col" bindtap="goKeys">
        <view class="quick-icon-circle bg-blue">🔑</view>
        <text class="quick-label">找钥匙</text>
      </view>
      <view class="quick-col" bindtap="goRecords">
        <view class="quick-icon-circle bg-orange">📋</view>
        <text class="quick-label">借还记录</text>
      </view>
      <view class="quick-col" bindtap="goHelp">
        <view class="quick-icon-circle bg-purple">💡</view>
        <text class="quick-label">使用守则</text>
      </view>
    </view>
  </view>

  <!-- P6: 设备状态降级展示 -->
  <view class="section-block device-section">
    <!-- 正常状态：紧凑单行条目 -->
    <view wx:if="{{deviceOnline}}" class="compact-device-bar card">
      <view class="device-bar-left">
        <text class="device-status-dot online"></text>
        <text class="device-bar-name">{{deviceName}}</text>
        <text class="device-bar-stat">● 在线 · {{availableSlotCount}}/{{totalSlotCount}} 钥匙可用</text>
      </view>
      <text class="device-bar-loc">信息楼 1F</text>
    </view>

    <!-- 异常状态：升级警告卡片 -->
    <view wx:else class="device-alert-card card">
      <view class="alert-header">
        <text class="alert-icon">⚠️</text>
        <text class="alert-title">{{deviceName}} 离线</text>
      </view>
      <view class="alert-desc">
        暂时无法现场取钥或归还，预约与记录查询不受影响。
      </view>
    </view>
  </view>
</view>
