<view class="page">
  <view class="card">
    <view class="card-title">智能钥匙管理</view>
    <view class="muted">欢迎使用</view>
  </view>

  <!-- 当前预约 -->
  <view wx:if="{{activeReservations.length > 0}}" class="card">
    <view class="card-title">我的预约</view>
    <view
      wx:for="{{activeReservations}}"
      wx:key="id"
      class="list-item"
      bindtap="goReservationDetail"
      data-id="{{item.id}}"
    >
      <view>
        <view>钥匙ID: {{item.keyId}}</view>
        <view class="muted">
          预约时间: {{formatTime(item.reservedAt)}} |
          过期时间: {{formatTime(item.expiresAt)}}
        </view>
        <view wx:if="{{item.purpose}}" class="muted small">用途: {{item.purpose}}</view>
      </view>
      <view class="tone-blue">● 待使用</view>
    </view>
  </view>

  <!-- 当前借用 -->
  <view wx:if="{{currentBorrows.length > 0}}" class="card">
    <view class="card-title">我的借用</view>
    <view
      wx:for="{{currentBorrows}}"
      wx:key="id"
      class="list-item"
      bindtap="goBorrowDetail"
      data-id="{{item.id}}"
    >
      <view>
        <view>钥匙ID: {{item.keyId}}</view>
        <view class="muted">
          预计归还: {{formatTime(item.expectedReturnAt)}}
        </view>
        <view wx:if="{{item.purpose}}" class="muted small">用途: {{item.purpose}}</view>
      </view>
      <view class="tone-{{isOverdue(item.expectedReturnAt) ? 'red' : 'orange'}}">
        ● {{isOverdue(item.expectedReturnAt) ? '逾期' : '借用中'}}
      </view>
    </view>
  </view>

  <!-- 快捷功能 -->
  <view class="card">
    <view class="card-title">快捷功能</view>
    <view class="grid-2">
      <view class="grid-item" bindtap="goKeys">找钥匙</view>
      <view class="grid-item" bindtap="goRecords">借还记录</view>
      <view class="grid-item" bindtap="goScan">扫码取钥</view>
      <view class="grid-item">故障反馈</view>
    </view>
  </view>

  <!-- 设备状态 -->
  <view class="card">
    <view class="card-title">设备状态</view>
    <view class="row-between">
      <view>{{deviceName}}</view>
      <view class="tone-{{tone}}">● {{deviceLabel}}</view>
    </view>
  </view>
</view>
