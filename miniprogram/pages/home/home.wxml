<view class="page">
  <!-- 首页头部问候与身份完善入口 -->
  <view class="home-hero">
    <view class="welcome-row">
      <view class="welcome">
        <view class="welcome-title">{{greetingText}}，{{userName}}</view>
        <view class="welcome-sub">今天有 {{pendingTaskCount}} 项借还事项需要处理</view>
      </view>
      <view
        wx:if="{{user && !user.identityVerified}}"
        class="identity-link"
        bindtap="goIdentityBind"
      >
        {{user.profileCompleted ? '身份待核验' : '完善身份'}}
      </view>
    </view>
  </view>

  <!-- P0: 未完成设备操作恢复卡片 (清新微光版) -->
  <view
    wx:if="{{activeOperation}}"
    class="progress-card card"
    bindtap="resumeOperation"
  >
    <view class="progress-top">
      <view class="progress-label">
        <view class="dot"></view>
        <text>检测到未完成设备操作</text>
      </view>
      <view class="status-chip chip-blue">进行中</view>
    </view>
    <view class="progress-main">
      <view class="progress-info">
        <view class="progress-key">
          {{activeOperationKeyName || (activeOperationKey ? activeOperationKey.name : '钥匙操作')}}
        </view>
        <view class="progress-meta">
          {{activeOperation.action === 'PICKUP' ? '正在现场取钥' : '正在到柜归还'}} · {{deviceName}}
        </view>
      </view>
      <view class="progress-action">继续处理 ›</view>
    </view>
  </view>

  <!-- P4 (主行动入口): 扫码使用钥匙柜 -->
  <view class="scan-entry" bindtap="onMainScanTap">
    <view class="scan-icon-box">
      <view class="scan-corners">
        <view class="scan-corner tl"></view>
        <view class="scan-corner tr"></view>
        <view class="scan-corner bl"></view>
        <view class="scan-corner br"></view>
        <view class="scan-line"></view>
      </view>
    </view>
    <view class="scan-center">
      <view class="scan-title">扫码使用钥匙柜</view>
      <view class="scan-desc">到柜后扫码，系统自动识别借取或归还</view>
    </view>
    <view class="scan-arrow">›</view>
  </view>

  <!-- P1: 逾期急需处理 -->
  <view wx:if="{{overdueBorrows.length > 0}}" class="section">
    <section-header
      title="逾期需处理 ({{overdueBorrows.length}})"
      subTitle="请尽快完成归还，避免影响后续借用"
    />
    <view wx:for="{{overdueBorrows}}" wx:key="id">
      <borrow-card
        borrow="{{item}}"
        showReturnBtn="{{true}}"
        bindreturn="onBorrowCardReturn"
      />
    </view>
  </view>

  <!-- P2: 待取预约 -->
  <view wx:if="{{activeReservations.length > 0}}" class="section">
    <section-header
      title="当前预约 ({{activeReservations.length}})"
      subTitle="审批通过后，请在取钥窗口内到柜扫码"
      actionText="查看记录"
      bindaction="goRecords"
    />
    <view wx:for="{{activeReservations}}" wx:key="id">
      <reservation-card
        reservation="{{item}}"
        showActions="{{true}}"
        bindpickup="onReservationCardPickup"
        bindcancel="onReservationCardCancel"
      />
    </view>
  </view>

  <!-- P3: 正常借用中 -->
  <view wx:if="{{normalBorrows.length > 0}}" class="section">
    <section-header
      title="当前借用中 ({{normalBorrows.length}})"
      subTitle="请留意归还时间，归还请到柜扫码"
      actionText="全部记录"
      bindaction="goRecords"
    />
    <view wx:for="{{normalBorrows}}" wx:key="id">
      <borrow-card
        borrow="{{item}}"
        showReturnBtn="{{true}}"
        bindreturn="onBorrowCardReturn"
      />
    </view>
  </view>

  <!-- P5: 常用服务 (纯白网格三列带分割线) -->
  <view class="section">
    <section-header title="常用服务" subTitle="快速进入常用功能" />
    <view class="quick-grid card">
      <view class="quick-item" bindtap="goKeys">
        <view class="quick-icon">
          <image class="quick-icon-img" src="/assets/icons/icon-key.svg" mode="aspectFit" />
        </view>
        <text class="quick-name">找钥匙</text>
      </view>
      <view class="quick-item" bindtap="goRecords">
        <view class="quick-icon">
          <image class="quick-icon-img" src="/assets/icons/icon-record.svg" mode="aspectFit" />
        </view>
        <text class="quick-name">借还记录</text>
      </view>
      <view class="quick-item" bindtap="goHelp">
        <view class="quick-icon">
          <image class="quick-icon-img" src="/assets/icons/icon-rule.svg" mode="aspectFit" />
        </view>
        <text class="quick-name">使用守则</text>
      </view>
    </view>
  </view>

  <!-- P6: 钥匙柜分布与可用状态 -->
  <view class="section cabinet-section">
    <view wx:if="{{deviceOnline}}" class="cabinet-status card">
      <view class="cabinet-info">
        <view class="cabinet-name">{{deviceName}}</view>
        <view class="cabinet-sub">{{deviceLocation || '信息楼 1F 门厅东侧'}} · 设备在线</view>
      </view>
      <view class="availability">
        <text class="avail-num">{{availableSlotCount}} / {{totalSlotCount}}</text>
        <text class="avail-label">钥匙可借</text>
      </view>
    </view>
    <view wx:else class="cabinet-status card alert-offline">
      <view class="cabinet-info">
        <view class="cabinet-name">{{deviceName}}</view>
        <view class="cabinet-sub danger">设备离线 · 暂无法现场取还</view>
      </view>
      <view class="availability">
        <text class="avail-offline">离线维护</text>
      </view>
    </view>
  </view>
</view>
