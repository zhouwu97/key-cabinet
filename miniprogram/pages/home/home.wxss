.page {
  padding: 24rpx;
  background-color: #f5f6f8;
  min-height: 100vh;
  box-sizing: border-box;
}

/* P0: 活跃操作横幅 */
.active-op-card {
  background: linear-gradient(135deg, #1f4788 0%, #2f6bff 100%);
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 28rpx;
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(47, 107, 255, 0.25);
  animation: op-glow 2.5s infinite alternate ease-in-out;
}

@keyframes op-glow {
  0% {
    box-shadow: 0 4rpx 16rpx rgba(47, 107, 255, 0.2);
  }
  100% {
    box-shadow: 0 8rpx 28rpx rgba(47, 107, 255, 0.45);
  }
}

.active-op-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.active-op-pulse {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background-color: #00ffaa;
  box-shadow: 0 0 10rpx #00ffaa;
}

.active-op-title {
  font-size: 26rpx;
  font-weight: 500;
  opacity: 0.9;
  flex: 1;
}

.active-op-badge {
  font-size: 20rpx;
  background-color: rgba(255, 255, 255, 0.2);
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  letter-spacing: 1rpx;
}

.active-op-body {
  margin-bottom: 16rpx;
}

.active-op-name {
  font-size: 34rpx;
  font-weight: 700;
  margin-right: 12rpx;
}

.active-op-action {
  font-size: 28rpx;
  opacity: 0.9;
}

.active-op-btn {
  font-size: 24rpx;
  opacity: 0.85;
  text-align: right;
  font-weight: 500;
}

/* 欢迎卡片 */
.welcome-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
}

.welcome-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2329;
  letter-spacing: 0.5rpx;
}

.welcome-sub {
  font-size: 26rpx;
  color: #8a919f;
  margin-top: 8rpx;
}

/* 模块区块 */
.section-block {
  margin-bottom: 28rpx;
}

/* 快捷服务网格 */
.quick-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.quick-item {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  transition: transform 0.15s ease;
}

.quick-item:active {
  transform: scale(0.98);
}

.quick-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.quick-icon {
  font-size: 36rpx;
}

.icon-blue {
  background-color: #eaf1ff;
}

.icon-green {
  background-color: #e6f8f1;
}

.icon-orange {
  background-color: #fff4e8;
}

.icon-purple {
  background-color: #f4efff;
}

.quick-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
}

.quick-desc {
  font-size: 22rpx;
  color: #8a919f;
  margin-top: 4rpx;
}
