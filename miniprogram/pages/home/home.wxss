/* 首页主容器 */
.page {
  padding: 24rpx;
  background-color: var(--kc-bg, #f5f6f8);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 问候与身份完善 Hero */
.home-hero {
  padding: 4rpx 4rpx 24rpx;
}

.welcome-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
}

.welcome {
  flex: 1;
}

.welcome-title {
  font-size: 46rpx;
  font-weight: 750;
  line-height: 1.3;
  color: var(--kc-text-primary, #20242c);
  letter-spacing: -0.6rpx;
}

.welcome-sub {
  margin-top: 10rpx;
  color: var(--kc-text-secondary, #5e6673);
  font-size: 26rpx;
}

.identity-link {
  border: 1rpx solid #d9e3ff;
  background-color: var(--kc-primary-soft, #eef3ff);
  color: var(--kc-primary, #2f67f6);
  font-size: 24rpx;
  border-radius: 20rpx;
  padding: 14rpx 20rpx;
  white-space: nowrap;
  font-weight: 600;
  line-height: 1.2;
}

.identity-link:active {
  opacity: 0.8;
}

/* P0: 活跃操作恢复卡片 (清新浅底微光版) */
.progress-card {
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  transition: transform 0.15s ease;
}

.progress-card:active {
  transform: scale(0.99);
}

.progress-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.progress-label {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 26rpx;
  color: var(--kc-text-secondary, #5e6673);
  font-weight: 500;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background-color: var(--kc-success, #0ca678);
  box-shadow: 0 0 0 6rpx var(--kc-success-soft, #eaf8f3);
  animation: pulse-dot 2s infinite ease-in-out;
}

@keyframes pulse-dot {
  0% { box-shadow: 0 0 0 4rpx var(--kc-success-soft, #eaf8f3); }
  50% { box-shadow: 0 0 0 10rpx rgba(12, 166, 120, 0.25); }
  100% { box-shadow: 0 0 0 4rpx var(--kc-success-soft, #eaf8f3); }
}

.progress-main {
  margin-top: 24rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
}

.progress-info {
  flex: 1;
}

.progress-key {
  font-size: 34rpx;
  font-weight: 750;
  color: var(--kc-text-primary, #20242c);
  line-height: 1.25;
}

.progress-meta {
  margin-top: 10rpx;
  color: var(--kc-text-muted, #9299a6);
  font-size: 24rpx;
}

.progress-action {
  font-size: 24rpx;
  color: var(--kc-primary, #2f67f6);
  font-weight: 600;
}

/* P4: 核心扫码行动卡片 */
.scan-entry {
  width: 100%;
  border-radius: var(--kc-radius-lg, 28rpx);
  background-color: var(--kc-primary, #2f67f6);
  color: #ffffff;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 30rpx;
  box-shadow: 0 14rpx 32rpx rgba(47, 103, 246, 0.22);
  margin-bottom: 36rpx;
  box-sizing: border-box;
  transition: transform 0.15s ease;
}

.scan-entry:active {
  transform: translateY(2rpx);
}

.scan-icon-box {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background-color: rgba(255, 255, 255, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.scan-corners {
  width: 38rpx;
  height: 38rpx;
  position: relative;
}

.scan-corner {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  border-color: #ffffff;
  border-style: solid;
}

.scan-corner.tl { top: 0; left: 0; border-width: 4rpx 0 0 4rpx; }
.scan-corner.tr { top: 0; right: 0; border-width: 4rpx 4rpx 0 0; }
.scan-corner.bl { bottom: 0; left: 0; border-width: 0 0 4rpx 4rpx; }
.scan-corner.br { bottom: 0; right: 0; border-width: 0 4rpx 4rpx 0; }

.scan-line {
  position: absolute;
  top: 50%;
  left: 6rpx;
  right: 6rpx;
  height: 3rpx;
  background-color: #ffffff;
  transform: translateY(-50%);
  opacity: 0.9;
}

.scan-center {
  flex: 1;
}

.scan-title {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

.scan-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
  margin-top: 6rpx;
}

.scan-arrow {
  font-size: 42rpx;
  opacity: 0.85;
  line-height: 1;
}

/* 区块间距 */
.section {
  margin-bottom: 32rpx;
}

/* P5: 常用服务三等分纯净网格 */
.quick-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  padding: 0;
  overflow: hidden;
  margin-bottom: 0;
}

.quick-item {
  padding: 30rpx 16rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  position: relative;
  background-color: #ffffff;
}

.quick-item + .quick-item::before {
  content: "";
  position: absolute;
  left: 0;
  top: 30rpx;
  bottom: 30rpx;
  width: 1rpx;
  background-color: var(--kc-line, #e7e9ee);
}

.quick-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  background-color: var(--kc-surface-2, #f8f9fb);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
}

.quick-name {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--kc-text-primary, #20242c);
}

/* P6: 钥匙柜可用度状态卡片 */
.cabinet-section {
  margin-bottom: 12rpx;
}

.cabinet-status {
  padding: 26rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 0;
}

.cabinet-info {
  flex: 1;
}

.cabinet-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--kc-text-primary, #20242c);
}

.cabinet-sub {
  margin-top: 8rpx;
  color: var(--kc-text-muted, #9299a6);
  font-size: 24rpx;
}

.cabinet-sub.danger {
  color: var(--kc-danger, #e5484d);
}

.availability {
  text-align: right;
  flex-shrink: 0;
}

.avail-num {
  display: block;
  font-size: 32rpx;
  font-weight: 750;
  color: var(--kc-success, #0ca678);
  line-height: 1.2;
}

.avail-label {
  display: block;
  font-size: 22rpx;
  color: var(--kc-text-secondary, #5e6673);
  margin-top: 4rpx;
}

.avail-offline {
  font-size: 24rpx;
  color: var(--kc-danger, #e5484d);
  font-weight: 600;
}
