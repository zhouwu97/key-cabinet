cabinet:
  # 真实柜机 ID 与 CSPRNG 64位随机十六进制 Secret
  device_id: "CAB001"
  device_secret: "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
  server_url: "http://127.0.0.1:8080"
  timeout_seconds: 5

camera:
  device_index: 0
  frame_width: 640
  frame_height: 480
  fps: 30

recognition:
  confidence_threshold: 0.80
  template_dir: "templates"
  max_faces_track: 1
  # 可选指定的深度模型路径 (ONNX 或 RKNN)
  model_path: "edge/rk3588/face_app/models/mobilefacenet.onnx"
  allow_handcrafted_fallback: false

liveness:
  laplacian_threshold: 85.0    # 模糊度拦截阈值 (Laplacian 方差，<85.0 判定虚焦/低质照片)
  accept_score: 0.85           # 综合活体置信度通过阈值 (0.0 ~ 1.0)
  fft_high_freq_threshold: 0.80 # 摩尔条纹高频能量比阈值 (>0.80 判定屏幕翻拍)
  glare_ratio_threshold: 0.15   # 高反光像素占比阈值 (>0.15 判定高反光屏幕或反光介质)
